<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>snap_test</RootNamespace>
    <UserSecretsId>dfd8ce6a-65a0-4225-84f4-76cfd15962f4</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..</DockerfileContext>
    <!-- XML docs feed Swagger summaries; undocumented members are fine. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Assembly / release metadata. CI overrides Version from the git tag (-p:Version=x.y.z). -->
    <Version>1.0.0</Version>
    <Authors>Sagar Kapase</Authors>
    <Product>APIBee</Product>
    <Description>Hardcoded dummy APIs for testing HTTP clients, API tools and automation suites.</Description>
    <Copyright>Copyright (c) 2026 Sagar Kapase</Copyright>
    <RepositoryUrl>https://github.com/SagarKapase/snap-test</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="15.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.15.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
  </ItemGroup>

  <!-- Ship the license texts with every build/publish output (release archives, Docker image). Conditional so
       builds whose context is only this folder (e.g. a Docker build context of snap-test/) still succeed. -->
  <ItemGroup>
    <None Include="..\LICENSE" Condition="Exists('..\LICENSE')" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Condition="Exists('..\THIRD-PARTY-NOTICES.md')" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
