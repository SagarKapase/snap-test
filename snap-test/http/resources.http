@host = http://localhost:5251

### ==================== EMPLOYEES ====================
GET {{host}}/api/employees?department=engineering&sort=salary&order=desc&limit=5&page=1

###
GET {{host}}/api/employees/count

###
GET {{host}}/api/employees/1

###
HEAD {{host}}/api/employees/1

###
GET {{host}}/api/employees/2/reports

###
GET {{host}}/api/employees/departments

###
GET {{host}}/api/employees/stats

###
POST {{host}}/api/employees
Content-Type: application/json

{
  "firstName": "Grace",
  "lastName": "Hopper",
  "email": "grace.hopper@nimbuscloud.example.com",
  "department": "Engineering",
  "title": "Principal Engineer",
  "salary": 210000,
  "hireDate": "2026-09-30",
  "managerId": 2,
  "companyId": 1,
  "skills": ["COBOL", "Compilers"],
  "address": { "street": "1 Navy Way", "city": "San Francisco", "state": "CA", "zip": "94105", "country": "USA" },
  "active": true
}

###
PATCH {{host}}/api/employees/5
Content-Type: application/json

{ "title": "Senior Software Engineer", "salary": 150000 }

###
DELETE {{host}}/api/employees/bulk?ids=24,25

