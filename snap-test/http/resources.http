### ==================== GRAPHQL ====================
POST {{host}}/graphql
Content-Type: application/json

{ "query": "{ employees(department: \"engineering\") { id firstName title salary address { city } } companies { name headquarters { city } } }" }

###
POST {{host}}/graphql
Content-Type: application/json

{ "query": "{ country(code: \"JP\") { name capital currency { code symbol } } movies(genre: \"sci-fi\") { title year rating } photos(albumId: 1) { id url } }" }

###
POST {{host}}/graphql
Content-Type: application/json

{ "query": "mutation { addTodo(title: \"Write tests\", userId: 101, priority: \"high\") { id title completed } }" }

###
POST {{host}}/graphql
Content-Type: application/json

{ "query": "mutation { toggleTodo(id: 1) { id completed } }" }
